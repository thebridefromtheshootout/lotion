    "menus": {
      "view/title": [
        {
          "command": "lotion.refreshBacklinks",
          "when": "view == lotion.backlinks",
          "group": "navigation"
        },
        {
          "command": "lotion.refreshOutline",
          "when": "view == lotion.outline",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "lotion.fireInto",
        "key": "ctrl+alt+f",
        "mac": "cmd+alt+f"
      },
      {
        "command": "lotion.smartPaste",
        "key": "ctrl+v",
        "mac": "cmd+v",
        "when": "editorTextFocus && editorLangId == markdown"
      },
      {
        "command": "lotion.toggleBold",
        "key": "ctrl+b",
        "mac": "cmd+b",
        "when": "editorTextFocus && editorLangId == markdown && lotion.cursorOnNonEmptyLine  && lotion.hasNonEmptySelection"
      },
      {
        "command": "lotion.toggleItalic",
        "key": "ctrl+i",
        "mac": "cmd+i",
        "when": "editorTextFocus && editorLangId == markdown && lotion.hasNonEmptySelection"
      },
      {
        "command": "lotion.toggleStrikethrough",
        "key": "alt+s",
        "mac": "alt+s",
        "when": "editorTextFocus && editorLangId == markdown && lotion.hasNonEmptySelection"
      },
      {
        "command": "lotion.toggleInlineCode",
        "key": "alt+`",
        "mac": "alt+`",
        "when": "editorTextFocus && editorLangId == markdown && lotion.hasNonEmptySelection"
      },
      {
        "command": "lotion.toggleHighlight",
        "key": "alt+h",
        "mac": "alt+h",
        "when": "editorTextFocus && editorLangId == markdown && lotion.hasNonEmptySelection"
      },
      {
        "command": "lotion.searchWorkspaceLinks",
        "key": "alt+l",
        "mac": "alt+l",
        "when": "editorTextFocus && editorLangId == markdown"
      },
      {
        "command": "lotion.searchWorkspaceCommands",
        "key": "ctrl+alt+c",
        "mac": "ctrl+alt+c",
        "when": "editorTextFocus && editorLangId == markdown"
      },
      {
        "command": "lotion.listContinue",
        "key": "enter",
        "mac": "enter",
        "when": "editorTextFocus && editorLangId == markdown && !suggestWidgetVisible && !editorHasMultipleSelections && !inSnippetMode"
      },
      {
        "command": "lotion.tableTabForward",
        "key": "alt+right",
        "mac": "alt+right",
        "when": "editorTextFocus && editorLangId == markdown && lotion.cursorInTable"
      },
      {
        "command": "lotion.tableTabBackward",
        "key": "alt+left",
        "mac": "alt+left",
        "when": "editorTextFocus && editorLangId == markdown && lotion.cursorInTable"
      },
      {
        "command": "cursorDown",
        "key": "alt+down",
        "mac": "alt+down",
        "when": "editorTextFocus && editorLangId == markdown && lotion.cursorInTable"
      },
      {
        "command": "cursorUp",
        "key": "alt+up",
        "mac": "alt+up",
        "when": "editorTextFocus && editorLangId == markdown && lotion.cursorInTable"
      },
      {
        "command": "lotion.tableJumpRowStart",
        "key": "alt+home",
        "mac": "alt+home",
        "when": "editorTextFocus && editorLangId == markdown && lotion.cursorInTable"
      },
      {
        "command": "lotion.tableJumpRowEnd",
        "key": "alt+end",
        "mac": "alt+end",
        "when": "editorTextFocus && editorLangId == markdown && lotion.cursorInTable"
      },
      {
        "command": "lotion.tableJumpColStart",
        "key": "alt+pageup",
        "mac": "alt+pageup",
        "when": "editorTextFocus && editorLangId == markdown && lotion.cursorInTable"
      },
      {
        "command": "lotion.tableJumpColEnd",
        "key": "alt+pagedown",
        "mac": "alt+pagedown",
        "when": "editorTextFocus && editorLangId == markdown && lotion.cursorInTable"
      },
      {
        "command": "lotion.jumpToNextHeading",
        "key": "alt+j",
        "mac": "alt+j",
        "when": "editorTextFocus && editorLangId == markdown && !lotion.cursorInTable"
      },
      {
        "command": "lotion.jumpToPrevHeading",
        "key": "alt+k",
        "mac": "alt+k",
        "when": "editorTextFocus && editorLangId == markdown && !lotion.cursorInTable"
      },
      {
        "command": "lotion.jumpToHeading",
        "key": "ctrl+shift+h",
        "mac": "cmd+shift+h",
        "when": "editorTextFocus && editorLangId == markdown"
      },
      {
        "command": "lotion.duplicateBlock",
        "key": "ctrl+shift+d",
        "mac": "cmd+shift+d",
        "when": "editorTextFocus && editorLangId == markdown"
      },
      {
        "command": "lotion.toggleCheckbox",
        "key": "alt+d",
        "mac": "alt+d",
        "when": "editorTextFocus && editorLangId == markdown"
      },
      {
        "command": "lotion.indentList",
        "key": "tab",
        "when": "editorTextFocus && editorLangId == markdown && !editorHasSelection && !inSnippetMode && !suggestWidgetVisible"
      },
      {
        "command": "lotion.outdentList",
        "key": "shift+tab",
        "when": "editorTextFocus && editorLangId == markdown && !inSnippetMode && !suggestWidgetVisible"
      },
      {
        "command": "lotion.promoteHeading",
        "key": "alt+shift+left",
        "mac": "alt+shift+left",
        "when": "editorTextFocus && editorLangId == markdown"
      },
      {
        "command": "lotion.demoteHeading",
        "key": "alt+shift+right",
        "mac": "alt+shift+right",
        "when": "editorTextFocus && editorLangId == markdown"
      },
      {
        "command": "lotion.selectBlock",
        "key": "ctrl+shift+b",
        "mac": "cmd+shift+b",
        "when": "editorTextFocus && editorLangId == markdown"
      },
      {
        "command": "lotion.quickSwitch",
        "key": "alt+p",
        "mac": "alt+p",
        "when": "editorLangId == markdown"
      },
      {
        "command": "lotion.swapBlockUp",
        "key": "alt+shift+up",
        "mac": "alt+shift+up",
        "when": "editorTextFocus && editorLangId == markdown"
      },
      {
        "command": "lotion.swapBlockDown",
        "key": "alt+shift+down",
        "mac": "alt+shift+down",
        "when": "editorTextFocus && editorLangId == markdown"
      },
      {
        "command": "lotion.recentPages",
        "key": "alt+r",
        "mac": "alt+r",
        "when": "editorLangId == markdown"
      }
    ],
    "configuration": {
      "title": "Lotion",
      "properties": {
        "lotion.dailyNotePath": {
          "type": "string",
          "default": "journal",
          "description": "Folder (relative to workspace root) where daily notes are created."
        },
        "lotion.imageDir": {
          "type": "string",
          "default": ".rsrc",
          "description": "Folder name used to store images alongside each page."
        },
        "lotion.readingSpeed": {
          "type": "number",
          "default": 230,
          "description": "Words per minute used to estimate reading time."
        },
        "lotion.smartPaste.debug": {
          "type": "boolean",
          "default": false,
          "description": "Log smart-paste decisions to the developer console for debugging."
        },
        "lotion.smartTypography": {
          "type": "boolean",
          "default": false,
          "description": "Auto-replace straight quotes, dashes, and ellipses with typographic equivalents."
        },
        "lotion.ligatureStyle": {
          "type": "string",
          "enum": [
            "off",
            "unicode",
            "emoji"
          ],
          "default": "unicode",
          "description": "Replace common arrow ligatures like ->, <-, and <-> with unicode or emoji arrows."
        },
        "lotion.autoRenumberLists": {
          "type": "boolean",
          "default": true,
          "description": "Automatically renumber ordered lists on save."
        },
        "lotion.trailingNewline": {
          "type": "boolean",
          "default": true,
          "description": "Ensure files end with exactly one trailing newline on save."
        },
        "lotion.dateFormat": {
          "type": "string",
          "default": "YYYY-MM-DD",
          "description": "Date format used for daily notes and date insertion (YYYY, MM, DD, ddd, etc.)."
        },
        "lotion.gifProvider": {
          "type": "string",
          "enum": [
            "giphy",
            "klipy"
          ],
          "default": "",
          "description": "GIF search provider: 'giphy' or 'klipy'."
        },
        "lotion.giphyApiKey": {
          "type": "string",
          "default": "",
          "description": "Giphy API key for GIF search. Get a free key at https://developers.giphy.com/"
        },
        "lotion.klipyApiKey": {
          "type": "string",
          "default": "",
          "description": "Klipy API key for GIF search. Get a key at https://developer.klipy.com/"
        },
        "lotion.git.neverPush": {
          "type": "boolean",
          "default": false,
          "description": "When true, the /commit slash command will never push to a remote after committing."
        },
        "lotion.git.remoteUrl": {
          "type": "string",
          "default": "",
          "description": "Git remote URL to add when no remote is configured."
        },
        "lotion.autoInlineCodeCases": {
          "type": "object",
          "default": {
            "PascalCase": false,
            "camelCase": false,
            "snake_case": false
          },
          "properties": {
            "PascalCase": {
              "type": "boolean",
              "default": false,
              "description": "Auto wrap PascalCase words in inline code."
            },
            "camelCase": {
              "type": "boolean",
              "default": false,
              "description": "Auto wrap camelCase words in inline code."
            },
            "snake_case": {
              "type": "boolean",
              "default": false,
              "description": "Auto wrap snake_case words in inline code."
            }
          },
          "description": "Automatically wrap identifier-cased words in backticks when a space or punctuation is typed after them."
        },
        "lotion.linkFactoryRules": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "required": [
              "match",
              "prefix"
            ],
            "properties": {
              "match": {
                "type": "string",
                "description": "Regex pattern to match typed text (e.g. \"#\\\\d+\" to match #123)."
              },
              "prefix": {
                "type": "string",
                "description": "URL prefix prepended to the matched text."
              },
              "suffix": {
                "type": "string",
                "default": "",
                "description": "URL suffix appended to the matched text."
              }
            }
          },
          "description": "Rules to auto-convert typed patterns into links. When text matching a rule's regex is typed followed by a space, it becomes an <a> tag with the URL built from prefix + match + suffix, and the page title is fetched."
        },
        "lotion.smartPasteLinkLabelMaxLength": {
          "type": "number",
          "default": 30,
          "minimum": 10,
          "description": "Maximum character length for auto-generated link labels in smart paste. Longer titles are truncated with …."
        },
        "lotion.commentUsername": {
          "type": "string",
          "default": "",
          "description": "Your name for comments. Set automatically on first comment."
        }
      }
    }
  },
  "scripts": {
    "package": "npx vsce package",
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ && node esbuild.webview.mjs && npm run docs:slash-table",
    "compile:webview": "node esbuild.webview.mjs",
    "docs:slash-table": "node scripts/generateReadmeSlashTable.mjs",
    "docs:check": "node scripts/generateReadmeSlashTable.mjs && git diff --quiet -- README.md",
    "watch": "tsc -watch -p ./",
    "watch:webview": "node esbuild.webview.mjs --watch",
    "test": "jest --verbose",
    "pretest:int": "node -e \"require('fs').rmSync('out/test',{recursive:true,force:true})\" && npm run compile",
    "test:int": "sh -c 'if command -v xvfb-run >/dev/null 2>&1; then xvfb-run -a vscode-test \"$@\"; else vscode-test \"$@\"; fi' --",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "simple-git-hooks || true"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx,css,md,json,mjs}": "prettier --check"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/leaflet": "^1.9.21",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.2.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/vscode": "^1.80.0",
    "@vscode/codicons": "^0.0.45",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.27.3",
    "jest": "^30.2.0",
    "lint-staged": "^16.2.4",
    "mocha": "^11.7.5",
    "prettier": "^3.8.1",
    "simple-git-hooks": "^2.13.1",
    "ts-jest": "^29.4.6",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "@types/d3-force": "^3.0.10",
    "@viz-js/viz": "^3.24.0",
    "d3-force": "^3.0.0",
    "leaflet": "^1.9.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "unicode-emoji-json": "^0.8.0"
  }
}
